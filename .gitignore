# ================================
# DO NOT IGNORE (Keep these in version control)
# ================================
# !.env.example
# !docker-compose.yml
# !.gitignore
# !README.md
# !LICENSE
# !CONTRIBUTING.md

# ================================
# Note for Contributors
# ================================
# This .gitignore is comprehensive for backend development.
# Comment out any section that doesn't apply to your specific project.
# Always test your .gitignore with: git status --ignored